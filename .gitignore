# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# renders
/public/renders/

# user-submitted feedback (local runtime logs)
/data/feedback/

# hyperframes engine port experiment (sandbox)
/hyperframes-test/

# too large for GitHub (>100MB) — kept locally / in backups, use Git LFS if it must be tracked
/public/assets/brand-deal-spy-src.mp4

# unrelated data export (X mentions scrape)
/apify_x_mentions_*.json

# per-user data — every user keeps their own local project library
/data/projects/
/data/collections.json

# separate cloned repo (trovevault/video-studio), not part of this project
/video-studio/

# per-deliverable render-check stills — throwaway frames from the render→look→fix
# loop, regenerated by scripts/still-*.cjs and scripts/verify-*.cjs
/data/*/check/
/data/*/check-*/

# local vhs 0.11.0 binary (VHS 0.12.0 never runs the ffmpeg encode)
/.tools/
